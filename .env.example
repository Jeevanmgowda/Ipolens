# ==============================================================================
# IPOLENS — Environment Configuration & Live Market Credentials
# Copy this file to .env.local and configure your environment
# ==============================================================================

NODE_ENV=development

# ------------------------------------------------------------------------------
# Free-Development Mode Toggle
# When 'true': Uses realistic demo market prices, OHLC candles, and subscription books.
# When 'false': Uses live external APIs (Upstox, NSE feeds, etc.).
# ------------------------------------------------------------------------------
USE_MOCK_MARKET_DATA=true

# ------------------------------------------------------------------------------
# Upstox Developer API v2
# ------------------------------------------------------------------------------
UPSTOX_API_KEY=""
UPSTOX_API_SECRET=""
UPSTOX_REDIRECT_URI="http://localhost:3000/api/auth/callback/upstox"
UPSTOX_ACCESS_TOKEN=""
UPSTOX_CLIENT_ID=""
UPSTOX_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# Upstox Automated Headless Token Refresh (Zero Human Interaction)
# When running `npm run dev`, IPOLENS automatically checks if your UPSTOX_ACCESS_TOKEN
# is valid. If expired, it uses these 3 credentials to refresh your daily token
# via headless Puppeteer and updates .env.local before Next.js boots up!
# ------------------------------------------------------------------------------
UPSTOX_MOBILE=""      # Registered 10-digit mobile number
UPSTOX_PIN=""         # 6-digit Upstox trading account PIN
UPSTOX_TOTP_KEY=""    # 32-character Base32 secret from Upstox Security -> 2FA Setup


# ------------------------------------------------------------------------------
# IPO Primary Market API Key (Optional)
# Where to obtain:
# Financial Modeling Prep (FMP) https://financialmodelingprep.com/developer/docs/
# or RapidAPI Indian Stock Exchange API
# ------------------------------------------------------------------------------
IPO_API_KEY=

# ------------------------------------------------------------------------------
# Grey Market Premium (GMP) API Key (Optional)
# Where to obtain:
# Specialized IPO market aggregators (e.g. IPOWatch / InvestorGain API)
# ------------------------------------------------------------------------------
GMP_API_KEY=

# ------------------------------------------------------------------------------
# Redis Cache (Optional)
# Used for real-time quotation caching and SSE broadcast scaling.
# Get free cloud Redis at: https://console.upstash.com/
# or use local: redis://localhost:6379
# ------------------------------------------------------------------------------
REDIS_URL=
UPSTASH_REDIS_URL=

# ------------------------------------------------------------------------------
# Client URL (for CORS and WebSocket origin verification)
# ------------------------------------------------------------------------------
CLIENT_URL=http://localhost:3000


# ------------------------------------------------------------------------------
# Google Gemini AI Configuration (for DRHP AI Analyst)
# Get from: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# Google OAuth 2.0 Sign-In (Official Google Identity Services)
# Get from: https://console.cloud.google.com/apis/credentials
# Authorized JavaScript Origin: http://localhost:3000
# Authorized Redirect URI: http://localhost:3000
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# Security Configuration
# Generate with: openssl rand -base64 32
# ------------------------------------------------------------------------------
NEXTAUTH_SECRET=your_nextauth_secret_here
# REQUIRED in production: AES-256-GCM key for encrypting stored PAN numbers.
# Changing it makes previously encrypted PANs unreadable.
PAN_ENCRYPTION_KEY=your_pan_encryption_key_here
COIN_JWE_KEY=your_jwe_key_here

# ------------------------------------------------------------------------------
# IPO Registrar Authorized B2B API Integrations (Optional — Gated by Default)
# Live automated direct checking remains disabled until a documented, authorized B2B
# endpoint, signed data-sharing agreement, and credentials are provided by the registrar.
# When omitted, IPOLENS uses the verified official registrar 1-click fallback.
# ------------------------------------------------------------------------------
MUFG_INTIME_API_KEY=""
MUFG_INTIME_API_SECRET=""
MUFG_INTIME_API_ENDPOINT=""
LINKINTIME_API_KEY="" # Legacy alias for MUFG Intime

KFINTECH_API_KEY=""
KFINTECH_API_SECRET=""
KFINTECH_API_ENDPOINT=""

BIGSHARE_API_KEY=""
BIGSHARE_API_SECRET=""
BIGSHARE_API_ENDPOINT=""
