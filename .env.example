# ==============================================================================
# IPOLENS environment. Copy to .env.local and fill in. Never commit real values.
# ==============================================================================

NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Database (required): Supabase Postgres with the pgvector extension.
# Supabase > Project Settings > Database > Connection string (Transaction pooler, port 6543).
# ------------------------------------------------------------------------------
DATABASE_URL=

# ------------------------------------------------------------------------------
# Redis (recommended): cache, locks, circuit breaker and rate limits across instances.
# Upstash: rediss://default:<password>@<host>.upstash.io:6379
# ------------------------------------------------------------------------------
UPSTASH_REDIS_URL=

# ------------------------------------------------------------------------------
# Security (required in production). Generate with: openssl rand -base64 32
# PAN_ENCRYPTION_KEY encrypts stored PANs; changing it makes existing PANs unreadable.
# PAN_HASH_SECRET keys the PAN fingerprints used in cache/lock keys.
# ------------------------------------------------------------------------------
PAN_ENCRYPTION_KEY=
PAN_HASH_SECRET=
NEXTAUTH_SECRET=
CRON_SECRET=

# ------------------------------------------------------------------------------
# Google Gemini (DRHP analyst: embeddings + analysis). https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_ANALYSIS_MODEL=gemini-2.5-pro
GEMINI_FAST_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# ------------------------------------------------------------------------------
# Inngest (cron + background jobs). Locally: `npm run inngest:dev` and set INNGEST_DEV=1.
# Production: keys from https://app.inngest.com
# ------------------------------------------------------------------------------
INNGEST_DEV=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ------------------------------------------------------------------------------
# Allotment checker
# REGISTRAR_DIRECT_QUERY=true lets the server query registrar public pages directly
# (undocumented endpoints; may be blocked and may be restricted by their terms).
# Off by default: users get a one-click link to the official registrar page instead.
# Authorized B2B credentials, when you have an agreement with a registrar:
# ------------------------------------------------------------------------------
REGISTRAR_DIRECT_QUERY=false
MUFG_INTIME_API_KEY=
KFINTECH_API_KEY=
BIGSHARE_API_KEY=

# ------------------------------------------------------------------------------
# Notifications
# Web Push: generate with `npx web-push generate-vapid-keys`
# WhatsApp: Twilio account + approved WhatsApp templates (approval can take days)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@example.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_TEMPLATE_ALLOTTED_SID=
TWILIO_TEMPLATE_NOT_ALLOTTED_SID=

# ------------------------------------------------------------------------------
# Google Sign-In (Google Identity Services). Authorized JavaScript origin: http://localhost:3000
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------------------
# Upstox (optional, used only by the Upstox sign-in helper scripts)
# ------------------------------------------------------------------------------
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:3000/api/auth/callback/upstox
UPSTOX_ACCESS_TOKEN=
