# ==============================================================================
# IPOLENS — Environment Configuration & Live Market Credentials
# Copy this file to .env.local and configure your environment
# ==============================================================================

NODE_ENV=development

# ------------------------------------------------------------------------------
# Free-Development Mode Toggle
# When 'true': Uses realistic demo market prices, OHLC candles, and subscription books.
# When 'false': Uses live external APIs (Upstox, NSE feeds, etc.).
# ------------------------------------------------------------------------------
USE_MOCK_MARKET_DATA=true

# ------------------------------------------------------------------------------
# Upstox Market Data Feed V3 (Preferred Live Provider)
# Where to obtain:
# 1. Sign up / Log in to Upstox Developer Console: https://developer.upstox.com/
# 2. Create an App under "Apps"
# 3. Copy your API Key (Client ID) and Secret
# 4. Generate your daily Access Token via OAuth2 flow
# ------------------------------------------------------------------------------
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# IPO Primary Market API Key (Optional)
# Where to obtain:
# Financial Modeling Prep (FMP) https://financialmodelingprep.com/developer/docs/
# or RapidAPI Indian Stock Exchange API
# ------------------------------------------------------------------------------
IPO_API_KEY=

# ------------------------------------------------------------------------------
# Grey Market Premium (GMP) API Key (Optional)
# Where to obtain:
# Specialized IPO market aggregators (e.g. IPOWatch / InvestorGain API)
# ------------------------------------------------------------------------------
GMP_API_KEY=

# ------------------------------------------------------------------------------
# Redis Cache (Optional)
# Used for real-time quotation caching and SSE broadcast scaling.
# Get free cloud Redis at: https://console.upstash.com/
# or use local: redis://localhost:6379
# ------------------------------------------------------------------------------
REDIS_URL=
UPSTASH_REDIS_URL=

# ------------------------------------------------------------------------------
# Client URL (for CORS and WebSocket origin verification)
# ------------------------------------------------------------------------------
CLIENT_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Angel One SmartAPI Credentials (Legacy / Alternative Provider)
# Get from Angel One API portal: https://api.angelbroking.com/
# ------------------------------------------------------------------------------
ANGEL_ONE_CLIENT_CODE=
ANGEL_ONE_API_KEY=
ANGEL_ONE_JWT_TOKEN=
ANGEL_ONE_FEED_TOKEN=
ANGEL_ONE_REFRESH_TOKEN=

# ------------------------------------------------------------------------------
# Google Gemini AI Configuration (for DRHP AI Analyst)
# Get from: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# Security Configuration
# Generate with: openssl rand -base64 32
# ------------------------------------------------------------------------------
NEXTAUTH_SECRET=your_nextauth_secret_here
COIN_JWE_KEY=your_jwe_key_here